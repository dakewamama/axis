# Axis frontend config. Copy to .env.local. NEVER commit real values.
# (.env* is gitignored by the Next.js default.)

# --- Server-only (never NEXT_PUBLIC_) ---

# Signs the httpOnly session cookie (HMAC-SHA256). 32+ random characters, e.g.
# `openssl rand -base64 48`. Without it no one can sign in, and every route that
# acts for a user returns 401/503. Rotating it signs everyone out.
AXIS_SESSION_SECRET=

# brain (the Axis MCP service): accounts and the assistant, under /web/*.
BRAIN_URL=
# Must match brain's AXIS_WEB_TOKEN (32+ characters). Sign-in refuses to run without it.
AXIS_WEB_TOKEN=

# onboarding payments service: wallet provisioning and spendable balance.
ONBOARDING_URL=
# Must match onboarding's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# --- Public (shipped to the browser; never put a secret here) ---

# Canonical site URL for metadata. Defaults to the Vercel alias.
NEXT_PUBLIC_SITE_URL=
# UI testing only: "1" skips the sign-up screens. Creates no session. Leave unset in production.
NEXT_PUBLIC_SKIP_ONBOARDING=
