# Axis frontend config. Copy to .env.local. NEVER commit real values.
# (.env* is gitignored by the Next.js default.)

# --- Server-only (never NEXT_PUBLIC_) ---

# Signs the httpOnly session cookie (HMAC-SHA256). 32+ random characters, e.g.
# `openssl rand -base64 48`. Without it no one can sign in, and every route that
# acts for a user (wallet, chat, name) returns 401/503. Rotating it signs everyone out.
AXIS_SESSION_SECRET=

# brain: email/password auth (/auth/*) and the web chat webhook (/webhooks/web).
BRAIN_URL=
# Must match brain's WEB_WEBHOOK_TOKEN. Chat refuses to run without it.
WEB_WEBHOOK_TOKEN=

# onboarding payments service: wallet provisioning and spendable balance.
ONBOARDING_URL=
# Must match onboarding's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# --- Public (shipped to the browser) ---

# Base URL of the crypto-funding API — the onboarding payments service
# (payments/src/server.ts, /funding/*). e.g. http://localhost:8788 in dev, or the
# Railway URL in production.
NEXT_PUBLIC_FUNDING_API=
