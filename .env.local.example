# Axis frontend config. Copy to .env.local. NEVER commit real values.
# (.env* is gitignored by the Next.js default.)

# Base URL of the crypto-funding API — the onboarding payments service
# (payments/src/server.ts, /funding/*). e.g. http://localhost:8788 in dev, or the
# Railway URL in production.
NEXT_PUBLIC_FUNDING_API=

# The user's Axis wallet address (Solana owner pubkey) to fund. PROTOTYPE stand-in
# only: in production this is the authenticated user's custodial pubkey from the
# onboarding custody server (getUserPublicKey), set at sign-in — not an env value.
NEXT_PUBLIC_AXIS_WALLET_ADDRESS=
